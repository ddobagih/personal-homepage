[Unit]
Description=thecistus homepage node app
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/thecistus.com/current
Environment=NODE_ENV=production
Environment=PORT=4173
Environment=APP_DATA_DIR=/var/lib/thecistus
EnvironmentFile=/var/www/thecistus.com/current/.env
ExecStart=/usr/bin/env node server.js
Restart=always
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
