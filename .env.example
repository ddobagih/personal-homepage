PORT=3000
APP_DATA_DIR=./data
ADMIN_EMAIL=admin@example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Homepage <no-reply@example.com>

# Or use a single URL instead of the fields above.
# SMTP_URL=smtps://user:pass@smtp.example.com:465

# Optional overrides
# CONTENT_PATH=/var/lib/thecistus/content.json
# COMMENTS_PATH=/var/lib/thecistus/comments.json
# AUTH_PATH=/var/lib/thecistus/admin-auth.json
# DEFAULT_CONTENT_PATH=/var/www/thecistus.com/current/data/default-content.json
# AUTH_TEMPLATE_PATH=/var/www/thecistus.com/current/data/admin-auth.json
